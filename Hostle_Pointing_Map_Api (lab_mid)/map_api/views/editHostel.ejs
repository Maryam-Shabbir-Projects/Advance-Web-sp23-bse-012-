<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Edit Hostel</title>

<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

<style>
body {
  font-family: Arial;
  margin: 20px;
  background: #f5f5f5;
}

.container {
  max-width: 900px;
  margin: auto;
  background: white;
  padding: 20px;
  border-radius: 10px;
  box-shadow: 0 0 10px rgba(0,0,0,0.1);
}

h1 {
  text-align: center;
}

form {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}

.full {
  grid-column: 1 / 3;
}

input, textarea {
  width: 100%;
  padding: 8px;
}

#map {
  height: 350px;
  border-radius: 8px;
  border: 2px solid #ccc;
}

.search-box {
  position: relative;
}

#suggestions {
  position: absolute;
  width: 100%;
  background: white;
  border: 1px solid #ccc;
  max-height: 150px;
  overflow-y: auto;
  z-index: 1000;
}

#suggestions li {
  padding: 8px;
  cursor: pointer;
}

#suggestions li:hover {
  background: #eee;
}

.buttons {
  grid-column: 1 / 3;
  display: flex;
  justify-content: space-between;
}

button {
  padding: 10px;
  border: none;
  cursor: pointer;
  border-radius: 5px;
}

.update-btn {
  background: #28a745;
  color: white;
}

.cancel-btn {
  background: #dc3545;
  color: white;
}
</style>
</head>

<body>

<div class="container">
<h1>✏️ Edit Hostel</h1>

<form id="editForm">

<input type="text" name="name" value="<%= hostel.name %>" placeholder="Name" required>

<input type="text" id="address" name="address" value="<%= hostel.address %>" placeholder="Address" required>

<input type="number" name="price" value="<%= hostel.price %>" placeholder="Price" required>

<input type="text" id="locationSearch" placeholder="Search new location..." oninput="liveSearch()">

<ul id="suggestions"></ul>

<textarea class="full" name="description"><%= hostel.description %></textarea>

<div id="map" class="full"></div>

<input type="hidden" name="latitude" id="latitude" value="<%= hostel.latitude %>">
<input type="hidden" name="longitude" id="longitude" value="<%= hostel.longitude %>">

<div class="buttons">
  <button type="button" class="cancel-btn" onclick="window.location.href='/admin'">Cancel</button>
  <button type="submit" class="update-btn">Update Hostel</button>
</div>

</form>
</div>

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<script>
// Initialize map with existing location
const lat = <%= hostel.latitude %>;
const lon = <%= hostel.longitude %>;

const map = L.map('map').setView([lat, lon], 16);

L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
  attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
  subdomains: 'abcd',
  maxZoom: 19
}).addTo(map);

let marker = L.marker([lat, lon], { draggable: true }).addTo(map);

marker.bindPopup("<b><%= hostel.name %></b>").openPopup();

// Update hidden fields on drag
marker.on("dragend", function () {
  const pos = marker.getLatLng();
  document.getElementById("latitude").value = pos.lat;
  document.getElementById("longitude").value = pos.lng;
});

// Click map to change location
map.on('click', function(e){
  marker.setLatLng(e.latlng);
  document.getElementById("latitude").value = e.latlng.lat;
  document.getElementById("longitude").value = e.latlng.lng;
});

// --------------------
// LIVE SEARCH
// --------------------
let debounceTimer;

function liveSearch(){
  const query = document.getElementById("locationSearch").value;

  clearTimeout(debounceTimer);

  if(!query){
    document.getElementById("suggestions").innerHTML = "";
    return;
  }

  debounceTimer = setTimeout(()=>{
    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&viewbox=72.30,30.02,72.40,30.08&bounded=1&limit=5`)
    .then(res=>res.json())
    .then(data=>showSuggestions(data));
  },400);
}

function showSuggestions(places){
  const list = document.getElementById("suggestions");
  list.innerHTML = "";

  places.forEach(place=>{
    const li = document.createElement("li");
    li.innerText = place.display_name;

    li.onclick = ()=>{
      const lat = parseFloat(place.lat);
      const lon = parseFloat(place.lon);

      marker.setLatLng([lat, lon]);
      map.setView([lat, lon], 16);

      document.getElementById("latitude").value = lat;
      document.getElementById("longitude").value = lon;
      document.getElementById("address").value = place.display_name;
      document.getElementById("locationSearch").value = place.display_name;

      list.innerHTML = "";
    };

    list.appendChild(li);
  });
}

// --------------------
// UPDATE FORM
// --------------------
document.getElementById("editForm").addEventListener("submit", async (e)=>{
  e.preventDefault();

  const form = e.target;

  const data = {
    name: form.name.value,
    address: form.address.value,
    price: form.price.value,
    description: form.description.value,
    latitude: form.latitude.value,
    longitude: form.longitude.value
  };

  try {
    const res = await fetch("/api/hostels/<%= hostel._id %>", {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data)
    });

    const result = await res.json();

    if(res.ok){
      alert("Hostel updated successfully!");
      window.location.href = "/admin";
    } else {
      alert(result.error || "Error updating");
    }

  } catch(err){
    console.error(err);
    alert("Server error");
  }
});
</script>

</body>
</html>